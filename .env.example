# =========================================================================
# Lindas & Elinas Bageri och Konditori — environment configuration
# Copy this file to `.env.local` and fill in the values you need.
# All values are OPTIONAL — the site works with sensible fallbacks if unset.
# =========================================================================

# ---- Site / SEO ---------------------------------------------------------
# The canonical production URL (no trailing slash). Used for metadata,
# canonical links, sitemap and JSON-LD. Falls back to a placeholder domain.
NEXT_PUBLIC_SITE_URL=https://lindaselinas.se

# ---- Cake / order enquiry form delivery ---------------------------------
# The order form works out of the box with a mailto: fallback (no config).
# To receive submissions server-side instead, set an inbox address AND one
# email provider below. Secrets are read ONLY on the server.
ORDER_INBOX_EMAIL=lindas.elinas@hotmail.com

# Option A — Resend (https://resend.com). Set the API key to enable.
# The "from" address must be a domain you have verified in Resend.
RESEND_API_KEY=
ORDER_FROM_EMAIL=bestallning@lindaselinas.se

# Option B — Generic webhook (Zapier, Make, Formspree, etc.).
# If set, the form POSTs the submission JSON to this URL.
ORDER_WEBHOOK_URL=

# ---- Analytics (optional, privacy-friendly, disabled by default) --------
# Only set this if you actually want analytics. When empty, no analytics
# script loads and no cookie consent banner is shown.
# Example: a Plausible domain such as "lindaselinas.se".
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
